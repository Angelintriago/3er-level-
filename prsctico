def construir_grafo(vuelos: List[Tuple]) -> nx.DiGraph:
    G = nx.DiGraph()
    for origen, destino, aerolinea, precio, duracion in vuelos:
        if G.has_edge(origen, destino):
            if precio < G[origen][destino]["precio"]:
                G[origen][destino]["precio"] = precio
                G[origen][destino]["aerolinea"] = aerolinea
                G[origen][destino]["duracion"] = duracion
        else:
            G.add_edge(origen, destino, precio=precio, aerolinea=aerolinea, duracion=duracion)
    return G


def reportar_estructura(G: nx.DiGraph) -> None:
    print("\n" + "=" * 70)
    print("REPORTERÍA DE LA ESTRUCTURA DE DATOS (GRAFO)")
    print("=" * 70)
    print(f"\n▶ Número de nodos (aeropuertos): {G.number_of_nodes()}")
    print(f"▶ Número de aristas (vuelos):    {G.number_of_edges()}")
    print("\n▶ Lista de nodos (aeropuertos):")
    for nodo in sorted(G.nodes()):
        print(f"   • {nodo} → {AEROPUERTOS.get(nodo, 'Desconocido')}")
    print("\n▶ Lista de aristas (vuelos) ordenadas por precio:")
    aristas = sorted(G.edges(data=True), key=lambda x: x[2]["precio"])
    for origen, destino, datos in aristas:
        print(f"   • {origen} → {destino} | ${datos['precio']:3d} USD | {datos['aerolinea']:8s} | {datos['duracion']:3d} min")
    print("\n▶ Grado de salida (vuelos que parten) por aeropuerto:")
    for nodo in sorted(G.nodes()):
        print(f"   • {nodo}: {G.out_degree(nodo)} vuelos")
    print("\n▶ Grado de entrada (vuelos que llegan) por aeropuerto:")
    for nodo in sorted(G.nodes()):
        print(f"   • {nodo}: {G.in_degree(nodo)} vuelos")


def consultar_vuelos_desde(G: nx.DiGraph, origen: str) -> None:
    print(f"\n▶ Vuelos que salen de {origen} ({AEROPUERTOS.get(origen, '')}):")
    if origen not in G:
        print("   Aeropuerto no encontrado en el grafo.")
        return
    for destino in G.successors(origen):
        datos = G[origen][destino]
        print(f"   → {destino} ({AEROPUERTOS.get(destino, '')}) | ${datos['precio']} USD | {datos['aerolinea']} | {datos['duracion']} min")


def encontrar_vuelo_mas_barato(G: nx.DiGraph, origen: str, destino: str):
    try:
        ruta = nx.dijkstra_path(G, origen, destino, weight="precio")
        costo = nx.dijkstra_path_length(G, origen, destino, weight="precio")
        return ruta, costo
    except (nx.NetworkXNoPath, nx.NodeNotFound):
        return None


def mostrar_ruta(ruta: List[str], costo: float, G: nx.DiGraph) -> None:
    print(f"\n✅ RUTA MÁS BARATA ENCONTRADA (Costo total: ${costo:.0f} USD)")
    print("-" * 60)
    for i in range(len(ruta) - 1):
        o, d = ruta[i], ruta[i + 1]
        datos = G[o][d]
        print(f"  {i+1}. {o} → {d}  |  ${datos['precio']} USD  |  {datos['aerolinea']}  |  {datos['duracion']} min")
        print(f"     {AEROPUERTOS.get(o, o)}  →  {AEROPUERTOS.get(d, d)}")
    print("-" * 60)
    print(f"  Total de escalas: {len(ruta) - 2}")
    print(f"  Aeropuertos visitados: {' → '.join(ruta)}")


def medir_tiempos(G: nx.DiGraph, origen: str, destino: str, repeticiones: int = 1000) -> Dict:
    tiempos = []
    for _ in range(repeticiones):
        inicio = time.perf_counter()
        encontrar_vuelo_mas_barato(G, origen, destino)
        fin = time.perf_counter()
        tiempos.append(fin - inicio)
    return {
        "promedio_ms": (sum(tiempos) / len(tiempos)) * 1000,
        "minimo_ms": min(tiempos) * 1000,
        "maximo_ms": max(tiempos) * 1000,
        "repeticiones": repeticiones,
    }


